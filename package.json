{
  "name": "capacitor-plugins-docs",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site for Capacitor Community plugins",
  "license": "MIT",
  "packageManager": "npm@11.7.0",
  "scripts": {
    "ng": "ng",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "prestart": "npm run docs:generate",
    "start": "ng serve",
    "prestart:ja": "npm run docs:generate",
    "start:ja": "ng serve --configuration ja",
    "prebuild": "npm run docs:generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run docs:generate",
    "test": "ng test --watch=false",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "serve:ssr:capacitor-plugins-docs": "node dist/capacitor-plugins-docs/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@capacitor-community/stripe-terminal": "^8.2.1",
    "express": "^5.1.0",
    "front-matter": "^4.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zenn-content-css": "^0.5.2",
    "zenn-markdown-html": "^0.5.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.1",
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/stripe": "^8.2.1",
    "@capacitor-community/stripe-identity": "^8.2.1",
    "@capacitor/docgen": "^0.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
